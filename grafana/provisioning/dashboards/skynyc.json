{
  "uid": "skynyc-main",
  "title": "SkyNYC",
  "timezone": "utc",
  "refresh": "15s",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "time": { "from": "now-12h", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "NWS alerts",
        "datasource": { "type": "postgres", "uid": "skynyc-pg" },
        "enable": true,
        "hide": false,
        "iconColor": "orange",
        "target": {
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT effective_ts AS time, ends_ts AS timeend, airport || ': ' || event AS text, airport AS tags FROM weather_alerts WHERE effective_ts < $__timeTo() AND coalesce(ends_ts, now()) > $__timeFrom()"
        },
        "filter": { "exclude": false, "ids": [5, 7] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Live NYC airspace",
      "description": "Airborne aircraft seen in the last 90 seconds, colored by barometric altitude (m). PRD §10 panel 1.",
      "type": "geomap",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 16, "w": 15, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT icao24, callsign, latitude, longitude, baro_alt_m, velocity_ms, track_deg, updated_at FROM live_states WHERE updated_at > now() - interval '90 seconds' AND NOT on_ground AND latitude IS NOT NULL AND longitude IS NOT NULL"
        },
        {
          "refId": "B",
          "format": "table",
          "rawSql": "SELECT 'JFK' AS airport, 40.6413 AS a_lat, -73.7781 AS a_lon UNION ALL SELECT 'LGA', 40.7769, -73.8740 UNION ALL SELECT 'EWR', 40.6895, -74.1745"
        }
      ],
      "options": {
        "view": { "id": "coords", "lat": 40.7, "lon": -73.95, "zoom": 8.5 },
        "basemap": { "type": "default", "name": "Basemap" },
        "layers": [
          {
            "type": "markers",
            "name": "Airports",
            "filterData": { "id": "byRefId", "options": "B" },
            "location": { "mode": "coords", "latitude": "a_lat", "longitude": "a_lon" },
            "config": {
              "style": {
                "size": { "fixed": 10 },
                "color": { "fixed": "orange" },
                "fillOpacity": 1,
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/x-mark.svg" },
                "text": { "mode": "field", "field": "airport" },
                "textConfig": { "fontSize": 13, "offsetY": -14, "textAlign": "center", "textBaseline": "middle" }
              },
              "showLegend": false
            },
            "tooltip": false
          },
          {
            "type": "markers",
            "name": "Aircraft",
            "location": { "mode": "coords", "latitude": "latitude", "longitude": "longitude" },
            "config": {
              "style": {
                "size": { "fixed": 9 },
                "color": { "field": "baro_alt_m" },
                "fillOpacity": 1,
                "symbol": { "mode": "fixed", "fixed": "img/icons/marker/plane.svg" },
                "symbolAlign": { "horizontal": "center", "vertical": "center" },
                "rotation": { "mode": "field", "field": "track_deg", "fixed": 0, "min": -360, "max": 360 }
              },
              "showLegend": true
            },
            "tooltip": true
          }
        ],
        "controls": { "showZoom": true, "mouseWheelZoom": true, "showAttribution": true }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "continuous-BlYlRd" },
          "min": 0,
          "max": 12000,
          "unit": "lengthm"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Current conditions",
      "description": "Latest observation per station; flight_category is the operational summary. PRD §10 panel 3.",
      "type": "table",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (station) station, obs_ts, text_desc, flight_category, wind_speed_kmh, wind_gust_kmh, visibility_m, ceiling_ft FROM weather_obs ORDER BY station, obs_ts DESC"
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "flight_category" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": {
                    "VFR":  { "color": "green",       "index": 0 },
                    "MVFR": { "color": "blue",        "index": 1 },
                    "IFR":  { "color": "red",         "index": 2 },
                    "LIFR": { "color": "dark-purple", "index": 3 }
                  } }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      }
    },
    {
      "id": 4,
      "title": "Pipeline freshness",
      "description": "Seconds since the newest live_states row — the end-to-end liveness signal (healthy < 90 s).",
      "type": "stat",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT extract(epoch from now() - max(updated_at)) AS staleness_s FROM live_states"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Arrivals per 15 min",
      "description": "Detected arrivals bucketed to 15 minutes per airport; NWS alert windows overlay as annotations. PRD §10 panel 2.",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 15, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_ts, '15m') AS time, airport AS metric, count(*) AS arrivals FROM flight_events WHERE event_type = 'arrival' AND $__timeFilter(event_ts) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Active alerts",
      "description": "NWS alert state per airport over time; 'clear' between alert windows. Concurrent alerts show the latest-starting one. PRD §10 panel 5.",
      "type": "state-timeline",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, airport, state FROM (SELECT effective_ts AS ts, airport, event AS state FROM weather_alerts UNION ALL SELECT ends_ts, airport, 'clear' FROM weather_alerts WHERE ends_ts IS NOT NULL) s WHERE ts < $__timeTo() ORDER BY 1"
        }
      ],
      "transformations": [
        { "id": "partitionByValues", "options": { "fields": ["airport"], "keepFields": false } }
      ],
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.85,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 70, "lineWidth": 0 },
          "mappings": [
            { "type": "value", "options": { "clear": { "color": "transparent", "index": 0 } } },
            { "type": "special", "options": { "match": "null", "result": { "color": "transparent", "index": 1 } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Holding minutes + go-arounds",
      "description": "Airborne delay across all three airports: holding minutes accumulated and go-arounds per 15 minutes; alert windows overlay. PRD §10 panel 4.",
      "type": "timeseries",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 15, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_ts, '15m') AS time, 'holding minutes' AS metric, round(sum(duration_s) / 60.0, 1) AS value FROM flight_events WHERE event_type = 'holding' AND $__timeFilter(event_ts) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(event_ts, '15m') AS time, 'go-arounds' AS metric, count(*) AS value FROM flight_events WHERE event_type = 'go_around' AND $__timeFilter(event_ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "short",
          "min": 0
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "go-arounds" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
              { "id": "custom.drawStyle", "value": "points" },
              { "id": "custom.showPoints", "value": "always" },
              { "id": "custom.pointSize", "value": 6 }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Arrival rate vs visibility",
      "description": "Each point is one airport-hour from fct_airport_hourly, colored by flight category — the live view of the business question. PRD §10 panel 6.",
      "type": "xychart",
      "datasource": { "type": "postgres", "uid": "skynyc-pg" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 24 },
      "timeFrom": "7d",
      "targets": [
        {
          "refId": "VFR",
          "format": "table",
          "rawSql": "SELECT visibility_m, arrivals_detected FROM analytics.fct_airport_hourly WHERE flight_category = 'VFR' AND visibility_m IS NOT NULL AND $__timeFilter(hour_ts)"
        },
        {
          "refId": "MVFR",
          "format": "table",
          "rawSql": "SELECT visibility_m, arrivals_detected FROM analytics.fct_airport_hourly WHERE flight_category = 'MVFR' AND visibility_m IS NOT NULL AND $__timeFilter(hour_ts)"
        },
        {
          "refId": "IFR",
          "format": "table",
          "rawSql": "SELECT visibility_m, arrivals_detected FROM analytics.fct_airport_hourly WHERE flight_category = 'IFR' AND visibility_m IS NOT NULL AND $__timeFilter(hour_ts)"
        },
        {
          "refId": "LIFR",
          "format": "table",
          "rawSql": "SELECT visibility_m, arrivals_detected FROM analytics.fct_airport_hourly WHERE flight_category = 'LIFR' AND visibility_m IS NOT NULL AND $__timeFilter(hour_ts)"
        }
      ],
      "options": {
        "mapping": "auto",
        "series": [{}],
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "show": "points", "pointSize": { "fixed": 6 }, "fillOpacity": 60 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byFrameRefID", "options": "VFR" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byFrameRefID", "options": "MVFR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byFrameRefID", "options": "IFR" },  "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byFrameRefID", "options": "LIFR" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-purple" } } ] }
        ]
      }
    }
  ]
}
