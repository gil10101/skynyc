# Public read-only API (public-dashboard spec §3.2). Slim on purpose: no Spark,
# no Kafka clients — this container only reads Postgres and speaks HTTP.
FROM python:3.11-slim
WORKDIR /app
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt
COPY api/ api/
EXPOSE 8000
# Single worker by design: TTL caches and the SSE sampler are process-local.
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
