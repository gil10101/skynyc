# SkyNYC configuration — copy to .env and fill in. PRD §11.
# .env is gitignored; never commit real credentials.

# --- OpenSky Network (Manual 01 §A) -----------------------------------------
# Create at https://opensky-network.org/my-opensky/account -> "Create new API client".
# The secret may only be shown once; if lost, delete the client and make a new one.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- NOAA / NWS (Manual 01 §B) ----------------------------------------------
# No account. A descriptive User-Agent is MANDATORY: "skynyc (<this email>)".
# Requests without it are rejected with 403.
CONTACT_EMAIL=you@example.com

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=skynyc
POSTGRES_PASSWORD=skynyc
POSTGRES_DB=skynyc
# From the host (psql, dbt on the laptop):
PG_DSN=postgresql://skynyc:skynyc@localhost:5432/skynyc
# From inside compose, use host "postgres" instead of "localhost":
# PG_DSN=postgresql://skynyc:skynyc@postgres:5432/skynyc

# --- Kafka ------------------------------------------------------------------
# Host tools (kcat) use localhost:9092; in-compose services use kafka:19092.
KAFKA_BOOTSTRAP=localhost:9092

# --- Ingestion (PRD §5.1, §2.3) ---------------------------------------------
# 30 s poll = 2,880 of 4,000 states credits/day. Hard floor is 22 s.
POLL_SECONDS=30
# lamin,lomin,lamax,lomax — 2.94 sq° => 1 credit/call.
BBOX=40.0,-75.0,41.4,-72.9

# --- Misc -------------------------------------------------------------------
TZ=UTC

# azure storage — bronze lake + backups (guide 3 §B; scripts/provision_azure.sh)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=bronze
AZURE_STORAGE_KEY=

# vps deployment (guide 3 §A; scripts/deploy.sh)
VPS_HOST=
VPS_SSH_KEY=~/.ssh/skynyc_vps_ed25519

# spark replay controls (guide 4; Manual 04 semantics)
# EVENTS_REPLAY_FROM=<epoch ms>   # honored only when checkpoints/events is fresh
KAFKA_STATES_PARTITIONS=3

# --- Historical lakehouse (PRD §13 M4A, v1.4) --------------------------------
# Terraform auth: subscription id for the azurerm provider (identity via az login).
ARM_SUBSCRIPTION_ID=
# Databricks Jobs API: workspace URL (https://adb-....azuredatabricks.net).
# Dagster authenticates as the dagster-orchestrator service principal via OAuth
# M2M (one-hour tokens minted per run) — ids from `scripts/tf.sh -chdir=databricks
# output`. DATABRICKS_TOKEN (a user PAT) is the dev-only fallback path.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=
# Job id emitted by `scripts/tf.sh -chdir=databricks output medallion_job_id`.
MEDALLION_JOB_ID=

# Grafana admin bootstrap password (initial boot only; change in the UI after)
GRAFANA_ADMIN_PASSWORD=
# ntfy.sh topic for the provisioned freshness alert (subscribe in the ntfy app)
NTFY_TOPIC=
